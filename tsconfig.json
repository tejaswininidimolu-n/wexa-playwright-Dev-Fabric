{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "paths": {
      "@pages/*": ["./playwright/pages/*"],
      "@fixtures/*": ["./playwright/fixtures/*"],
      "@data/*": ["./playwright/test-data/*"],
      "@utils/*": ["./playwright/utils/*"],
      "@constants/*": ["./playwright/constants/*"],
      "@helpers/*": ["./playwright/helpers/*"]
    },
    "types": ["node"]
  },
  "include": ["playwright.config.ts", "playwright/**/*.ts"],
  "exclude": ["node_modules", "playwright-report", "test-results"]
}
