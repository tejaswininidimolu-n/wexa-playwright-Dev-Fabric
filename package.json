{
  "name": "wexa-fabric-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript automation framework for Wexa Fabric.",
  "scripts": {
    "test": "playwright test --grep-invert @stateful",
    "test:smoke": "playwright test --grep @smoke --grep-invert @stateful",
    "test:functional": "playwright test playwright/tests/functional --grep-invert @stateful --pass-with-no-tests",
    "test:regression": "playwright test --grep @regression --grep-invert @stateful",
    "test:e2e": "playwright test playwright/tests/e2e --grep-invert @stateful --pass-with-no-tests",
    "test:api": "playwright test playwright/tests/api",
    "test:stateful": "playwright test --grep @stateful --workers=1",
    "test:headed": "playwright test --headed --grep-invert @stateful",
    "test:debug": "playwright test --debug --grep-invert @stateful",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@types/node": "latest",
    "dotenv": "^17.4.2",
    "typescript": "latest"
  }
}
